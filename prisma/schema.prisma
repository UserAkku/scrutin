generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          String    @default("free")
  auditsToday   Int       @default(0)
  lastAuditDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  audits        Audit[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Audit {
  id                 String    @id @default(cuid())
  userId             String?
  url                String
  hostname           String
  faviconUrl         String?
  screenshotUrl      String?   // desktop screenshot URL/base64 key
  mobileScreenshotUrl String?  // mobile screenshot
  isPublic           Boolean   @default(false)
  isGuest            Boolean   @default(false)
  
  // Job queue fields
  status             String    @default("pending") // pending | running | complete | error
  progress           Int       @default(0)         // 0-100 percent
  jobStartedAt       DateTime?
  jobCompletedAt     DateTime?
  currentStep        String?                        // which analyzer is running
  
  // Scores
  overallScore       Int       @default(0)
  performanceScore   Int       @default(0)
  seoScore           Int       @default(0)
  securityScore      Int       @default(0)
  uxScore            Int       @default(0)
  accessibilityScore Int       @default(0)
  technicalScore     Int       @default(0)
  
  // Rich data blobs per category
  performanceData    Json?
  seoData            Json?
  securityData       Json?
  uxData             Json?
  accessibilityData  Json?
  technicalData      Json?
  
  // Metadata
  targetTitle        String?   // page title of audited URL
  targetDescription  String?   // meta description
  techStack          Json?     // detected technology stack
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User?     @relation(fields: [userId], references: [id])
  issues             Issue[]
}

model Issue {
  id            String  @id @default(cuid())
  auditId       String
  category      String
  severity      String  // critical | medium | low
  title         String
  description   String  @db.Text
  fixSuggestion String  @db.Text
  impact        String? @db.Text
  effort        String?
  learnMoreUrl  String? // link to docs/reference for this issue
  audit         Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  @@index([auditId])
  @@index([category])
  @@index([severity])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
